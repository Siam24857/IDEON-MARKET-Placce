generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  username             String?   @unique
  email                String    @unique
  emailVerified        Boolean   @default(false)
  image                String?
  coverImage           String?
  bio                  String?
  location             String?
  skills               String[]  @default([])
  languages            String[]  @default([])
  timezone             String?
  website              String?
  github               String?
  linkedin             String?
  role                 String    @default("BUYER")
  status               String    @default("ACTIVE")
  verificationStatus   String    @default("UNVERIFIED")
  profileCompletion    Int       @default(0)
  preferredCurrency    String    @default("USD")
  stripeAccountId      String?   @unique
  stripeOnboardingDone Boolean   @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  freelancerProfile  FreelancerProfile?
  buyerProfile       BuyerProfile?
  portfolioItems     Portfolio[]
  services           Service[]
  ordersAsBuyer      Order[]                   @relation("OrderBuyer")
  ordersAsFreelancer Order[]                   @relation("OrderFreelancer")
  reviewsWritten     Review[]                  @relation("ReviewWriter")
  reviewsReceived    Review[]                  @relation("ReviewReceiver")
  favorites          Favorite[]
  cart               Cart?
  conversationParts  ConversationParticipant[]
  messages           Message[]
  notifications      Notification[]
  payouts            Payout[]
  disputes           Dispute[]                 @relation("DisputeOpener")
  reports            Report[]
  achievements       UserAchievement[]
  xp                 UserXP?
  searchHistory      SearchHistory[]

  userRoles              UserRole[]
  companiesOwned         Company[]          @relation("CompanyOwner")
  companyEmployees       Employee[]         @relation("EmployeeUser")
  jobsPosted             Job[]
  resumes                Resume[]
  jobApplications        JobApplication[]
  products               Product[]
  productReviewsWritten  ProductReview[]    @relation("ProductReviewWriter")
  productReviewsReceived ProductReview[]    @relation("ProductReviewReceiver")
  booksAuthored          Book[]             @relation("BookAuthor")
  bookPurchases          BookPurchase[]
  bookReviews            BookReview[]
  resourcesCreated       Resource[]         @relation("ResourceAuthor")
  portfolioProjects      PortfolioProject[]
  aiConversations        AIConversation[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, expiresAt])
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  headline    String?
  occupation  String?
  education   String?
  experience  String?
  phoneNumber String?
  country     String?
  city        String?
  dateOfBirth DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FreelancerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  title            String?
  about            String?   @db.Text
  skills           String[]  @default([])
  languages        String[]  @default([])
  level            String    @default("NEW")
  responseTime     Int       @default(0)
  responseRate     Int       @default(0)
  onTimeDelivery   Int       @default(0)
  explanationRate  Int       @default(0)
  completedOrders  Int       @default(0)
  successfulOrders Int       @default(0)
  ratingValue      Float     @default(0)
  reviewCount      Int       @default(0)
  status           String    @default("PENDING")
  verified         Boolean   @default(false)
  submittedAt      DateTime?
  approvedAt       DateTime?
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model BuyerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  orderCount Int      @default(0)
  totalSpent Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories Subcategory[]
  services      Service[]
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
}

model Service {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  shortDescription String?
  description      String    @db.Text
  userId           String
  categoryId       String
  subcategoryId    String?
  type             String    @default("SERVICE")
  status           String    @default("DRAFT")
  tags             String[]  @default([])
  technologies     String[]  @default([])
  languages        String[]  @default([])
  minPrice         Int       @default(0)
  maxPrice         Int       @default(0)
  deliveryTime     Int       @default(1)
  revisions        Int       @default(1)
  ratingValue      Float     @default(0)
  reviewCount      Int       @default(0)
  salesCount       Int       @default(0)
  views            Int       @default(0)
  favoritesCount   Int       @default(0)
  demoUrl          String?
  repositoryUrl    String?
  documentationUrl String?
  license          String?
  supportPeriod    Int?
  pages            String[]  @default([])
  features         String[]  @default([])
  requirements     String?   @db.Text
  isFeatured       Boolean   @default(false)
  reviewedAt       DateTime?
  rejectionReason  String?
  availability     String    @default("AVAILABLE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  packages    ServicePackage[]
  images      ServiceImage[]
  faqs        ServiceFAQ[]
  orderItems  OrderItem[]
  orders      Order[]
  reviews     Review[]
  cartItems   CartItem[]

  @@index([categoryId, status])
  @@index([subcategoryId])
  @@index([userId, status])
  @@index([status, minPrice])
  @@index([type])
  @@index([createdAt])
}

model ServicePackage {
  id           String   @id @default(cuid())
  serviceId    String
  name         String
  title        String?
  description  String?  @db.Text
  price        Int
  deliveryTime Int
  revisions    Int      @default(1)
  features     String[] @default([])
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([serviceId, name])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceFAQ {
  id        String @id @default(cuid())
  serviceId String
  question  String
  answer    String @db.Text
  sortOrder Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Portfolio {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?  @db.Text
  image        String?
  url          String?
  technologies String[] @default([])
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id                    String    @id @default(cuid())
  orderNumber           String    @unique
  buyerId               String
  freelancerId          String
  serviceId             String
  packageId             String    @unique
  status                String    @default("PENDING_PAYMENT")
  amount                Int
  platformFee           Int       @default(0)
  freelancerAmount      Int       @default(0)
  currency              String    @default("USD")
  quantity              Int       @default(1)
  couponCode            String?
  requirementsSubmitted Boolean   @default(false)
  paidAt                DateTime?
  deliveredAt           DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  revisionDeadline      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  buyer        User               @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  freelancer   User               @relation("OrderFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  service      Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  requirements OrderRequirement[]
  deliveries   OrderDelivery[]
  revisions    Revision[]
  review       Review?
  payment      Payment?
  refunds      Refund[]
  dispute      Dispute?
  messages     Conversation[]

  @@index([buyerId, status])
  @@index([freelancerId, status])
  @@index([serviceId])
  @@index([status, createdAt])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  serviceId    String
  packageName  String
  title        String
  price        Int
  quantity     Int    @default(1)
  deliveryTime Int
  revisions    Int    @default(1)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageId String

  @@index([orderId])
}

model OrderRequirement {
  id          String   @id @default(cuid())
  orderId     String
  responses   Json?
  submittedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderDelivery {
  id          String   @id @default(cuid())
  orderId     String
  message     String   @db.Text
  attachments String[] @default([])
  submittedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Revision {
  id          String   @id @default(cuid())
  orderId     String
  requestedBy String
  note        String?  @db.Text
  requestedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  serviceId  String
  reviewerId String
  revieweeId String
  rating     Int
  title      String?
  body       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewWriter", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ReviewReceiver", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([revieweeId])
  @@index([reviewerId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Cart {
  id         String   @id @default(cuid())
  userId     String   @unique
  shareToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([shareToken])
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  serviceId          String
  packageId          String
  quantity           Int      @default(1)
  price              Int
  customRequirements String?  @db.Text
  savedForLater      Boolean  @default(false)
  createdAt          DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([cartId, serviceId, packageId])
}

model Conversation {
  id            String    @id @default(cuid())
  orderId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([orderId])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  muted          Boolean   @default(false)
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  type           String    @default("TEXT")
  body           String    @db.Text
  status         String    @default("SENT")
  parentId       String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  parent       Message?            @relation("MessageReply", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReply")

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String?
  title     String
  body      String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  userId            String
  amount            Int
  currency          String    @default("USD")
  status            String    @default("PENDING")
  provider          String    @default("STRIPE")
  providerSessionId String?   @unique
  providerIntentId  String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([userId, status])
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  paymentId         String
  type              String
  amount            Int
  status            String   @default("SUCCEEDED")
  providerReference String?
  metadata          Json?
  createdAt         DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Refund {
  id               String    @id @default(cuid())
  paymentId        String
  orderId          String
  amount           Int
  reason           String?
  status           String    @default("PENDING")
  providerRefundId String?   @unique
  createdBy        String
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Payout {
  id               String    @id @default(cuid())
  freelancerId     String
  amount           Int
  platformFee      Int       @default(0)
  fee              Int       @default(0)
  status           String    @default("PENDING")
  providerPayoutId String?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  freelancer User @relation(fields: [freelancerId], references: [id], onDelete: Restrict)

  @@index([freelancerId, status])
  @@index([status, createdAt])
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String    @unique
  openerId   String
  reason     String?
  details    String?   @db.Text
  status     String    @default("OPEN")
  evidence   String[]  @default([])
  resolution String?   @db.Text
  openedAt   DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  opener User  @relation("DisputeOpener", fields: [openerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  details    String?  @db.Text
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    @default("PERCENT")
  value         Int
  maxUses       Int?
  usedCount     Int       @default(0)
  maxPerUser    Int?
  minOrderValue Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  usages CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  icon        String?
  xpReward    Int      @default(0)
  category    String?
  createdAt   DateTime @default(now())

  awards UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model UserXP {
  id        String   @id @default(cuid())
  userId    String   @unique
  totalXp   Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── ECOSYSTEM: Platform roles & permissions ───────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]

  @@index([key])
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  module    String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// ─── ECOSYSTEM: E-commerce (IDEONS Store) ───────────────────────────────

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([active])
}

model Product {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String
  userId         String
  categoryId     String?
  type           String    @default("PHYSICAL")
  status         String    @default("ACTIVE")
  price          Int       @default(0)
  compareAtPrice Int?
  currency       String    @default("USD")
  sku            String?
  stock          Int       @default(0)
  digitalFileUrl String?
  images         String[]  @default([])
  tags           String[]  @default([])
  isFeatured     Boolean   @default(false)
  ratingValue    Float     @default(0)
  reviewCount    Int       @default(0)
  salesCount     Int       @default(0)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  seller        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productImages ProductImage[]
  reviews       ProductReview[]

  @@index([categoryId, status])
  @@index([userId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductReview {
  id         String   @id @default(cuid())
  orderId    String   @unique
  productId  String
  reviewerId String
  revieweeId String
  rating     Int
  title      String?
  body       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ProductReviewWriter", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ProductReviewReceiver", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([reviewerId])
  @@index([revieweeId])
}

// ─── ECOSYSTEM: Job Hunter ──────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  website     String?
  description String?
  industry    String?
  location    String?
  size        String?
  verified    Boolean  @default(false)
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  jobs      Job[]
  employees Employee[]

  @@index([verified])
  @@index([industry])
}

model Job {
  id           String    @id @default(cuid())
  slug         String    @unique
  companyId    String
  title        String
  description  String
  requirements String?
  salaryMin    Int?
  salaryMax    Int?
  currency     String    @default("USD")
  location     String?
  remote       Boolean   @default(false)
  type         String    @default("FULL_TIME")
  level        String?
  category     String?
  tags         String[]  @default([])
  status       String    @default("OPEN")
  expiresAt    DateTime?
  views        Int       @default(0)
  postedById   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy     User?            @relation(fields: [postedById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([companyId, status])
  @@index([status])
  @@index([type])
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  applicantId String
  resumeId    String?
  status      String   @default("PENDING")
  coverLetter String?
  answers     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resume    Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([jobId, applicantId])
  @@index([applicantId])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  title      String
  fileUrl    String?
  content    String?
  skills     String[] @default([])
  experience Json?
  education  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  resumeScores ResumeScore[]

  @@index([userId])
}

model ResumeScore {
  id        String   @id @default(cuid())
  resumeId  String
  jobId     String?
  score     Int
  feedback  Json?
  engine    String   @default("INGETIC")
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

// ─── ECOSYSTEM: E-Book Platform (FAB E-Book) ────────────────────────────

model BookCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  books Book[]

  @@index([active])
}

model Book {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  author       String
  authorUserId String?
  bio          String?
  description  String?
  coverImage   String?
  categoryId   String?
  price        Int       @default(0)
  status       String    @default("PUBLISHED")
  pages        Int?
  edition      String?
  isbn         String?
  tags         String[]  @default([])
  ratingValue  Float     @default(0)
  reviewCount  Int       @default(0)
  salesCount   Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authorUser User?          @relation("BookAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  category   BookCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  chapters   BookChapter[]
  purchases  BookPurchase[]
  reviews    BookReview[]

  @@index([categoryId, status])
}

model BookChapter {
  id        String   @id @default(cuid())
  bookId    String
  title     String
  slug      String?
  content   String?
  sortOrder Int      @default(0)
  isFree    Boolean  @default(false)
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, sortOrder])
}

model BookPurchase {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  orderId   String?
  price     Int
  accessKey String?
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([userId])
}

model BookReview {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
}

// ─── ECOSYSTEM: Hello Resources ─────────────────────────────────────────

model ResourceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  resources Resource[]

  @@index([active])
}

model Resource {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  type          String   @default("DOCUMENT")
  categoryId    String?
  tags          String[] @default([])
  authorId      String?
  status        String   @default("PUBLISHED")
  downloadCount Int      @default(0)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?             @relation("ResourceAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  files    ResourceFile[]

  @@index([categoryId, status])
}

model ResourceFile {
  id           String  @id @default(cuid())
  resourceId   String
  name         String
  url          String
  size         Int     @default(0)
  mimeType     String?
  sortOrder    Int     @default(0)
  downloadable Boolean @default(true)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

// ─── ECOSYSTEM: Portfolio ───────────────────────────────────────────────

model PortfolioProject {
  id            String    @id @default(cuid())
  slug          String    @unique
  userId        String
  title         String
  description   String
  coverImage    String?
  gallery       String[]  @default([])
  tags          String[]  @default([])
  technologies  String[]  @default([])
  projectUrl    String?
  repositoryUrl String?
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  liveAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featured])
}

// ─── ECOSYSTEM: Company ID ──────────────────────────────────────────────

model Employee {
  id          String    @id @default(cuid())
  companyId   String
  userId      String?
  employeeId  String
  fullName    String
  email       String
  phone       String?
  department  String?
  position    String?
  joiningDate DateTime?
  status      String    @default("ACTIVE")
  idImage     String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeId])
  @@index([companyId, status])
}

// ─── ECOSYSTEM: Ingetic AI ──────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  module    String   @default("INGETIC")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolName       String?
  toolInput      Json?
  toolOutput     Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
