{
  "name": "@ideons/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IDEONS ECOSYSTEM — shared Prisma 7 data layer. Exposes the singleton PrismaClient bound to the root `prisma/` schema via PrismaPg.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "npm run db:generate --prefix ../..",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "npm run db:studio --prefix ../.."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}